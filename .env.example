APP_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://conference:conference@localhost:5432/conference_dev
# Generate independently for each environment: openssl rand -hex 32
DATA_ENCRYPTION_KEY=
TOKEN_PEPPER=
CRON_SECRET=
# Legacy Resend integration remains disabled; not required for SMTP sending.
RESEND_API_KEY=
MAIL_ENABLED=false
# SMTP home.pl is configured in Admin -> Wysyłka. Password is encrypted in DB.
# Requires APP_ENV=production, valid HTTPS APP_URL and DATA_ENCRYPTION_KEY.
# Saving the SMTP password does NOT send any email.
